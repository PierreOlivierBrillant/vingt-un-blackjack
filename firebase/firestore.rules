rules_version = '2';

// Server-authoritative model: clients only READ (and write two settings fields of their own
// settings document). Every mutation of money, cards, bets, ranks, markets, friendships,
// cosmetics, affinity or dating goes through callables (Admin SDK, which bypasses these rules).
// Anything not matched below is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // users/{uid}: the client may only set theme and language (+ updatedAtMs). Card styles
    // (cardBack / cardFace / felt) go through equipCardStyle, which checks exclusive cosmetics
    // are unlocked (users/{uid}/unlocks/{id}).
    function validSettingsValues(d) {
      return (!('theme' in d) || d.theme in ['dark', 'light', 'system'])
        && (!('language' in d) || d.language in ['fr', 'en'])
        && (!('updatedAtMs' in d) || d.updatedAtMs is int);
    }

    // Public profiles (username, avatar, rank, stats, title).
    match /profiles/{uid} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Own settings.
    match /users/{uid} {
      allow read: if isUser(uid);
      allow create: if isUser(uid)
        && request.resource.data.keys().hasOnly(['theme', 'language', 'updatedAtMs'])
        && validSettingsValues(request.resource.data);
      allow update: if isUser(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['theme', 'language', 'updatedAtMs'])
        && validSettingsValues(request.resource.data);
      allow delete: if false;

      // private/wallet, private/kyc, private/suggestions, private/ads, private/dating, ledger/*,
      // inventory/*, positions/*, romance/{characterId}, unlocks/{cosmeticId}: owner reads, nobody writes.
      match /{sub}/{doc=**} {
        allow read: if isUser(uid);
        allow write: if false;
      }
    }

    // Blackjack: public table state (seats, visible cards, phase, deadline).
    match /tables/{tableId} {
      allow read: if signedIn();
      allow write: if false;

      // Shoe, hole card, seed: nobody.
      match /private/{doc=**} {
        allow read, write: if false;
      }

      // Peek power result: only that user.
      match /peeks/{uid} {
        allow read: if isUser(uid);
        allow write: if false;
      }

      // Finished hands with provably-fair proof.
      match /hands/{handId} {
        allow read: if signedIn();
        allow write: if false;
      }
    }

    // Kernel-driven games (roulette, baccarat, hold'em, craps): public table state.
    match /gameTables/{tableId} {
      allow read: if signedIn();
      allow write: if false;

      // Seed, shoe / deck, secrets: nobody.
      match /private/{doc=**} {
        allow read, write: if false;
      }

      // Bet boards of the current round (public, written by the server only).
      match /bets/{uid} {
        allow read: if signedIn();
        allow write: if false;
      }

      // Hold'em hole cards: only that player.
      match /holes/{uid} {
        allow read: if isUser(uid);
        allow write: if false;
      }

      // Finished rounds with provably-fair proof.
      match /rounds/{roundId} {
        allow read: if signedIn();
        allow write: if false;
      }
    }

    // Spectator markets, trades, price history.
    match /markets/{marketId} {
      allow read: if signedIn();
      allow write: if false;

      match /trades/{tradeId} {
        allow read: if signedIn();
        allow write: if false;
      }

      match /priceHistory/{pointId} {
        allow read: if signedIn();
        allow write: if false;
      }
    }

    // Friendships: the two participants.
    match /friendships/{pairId} {
      allow read: if signedIn() && request.auth.uid in resource.data.uids;
      allow write: if false;
    }

    // Friend requests: sender or recipient.
    match /friendRequests/{requestId} {
      allow read: if signedIn()
        && (request.auth.uid == resource.data.fromUid || request.auth.uid == resource.data.toUid);
      allow write: if false;
    }

    // Recent wins ticker.
    match /feed/{entryId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Player-to-player dating: the two members of an ACTIVE match (query:
    // where('uids','array-contains',me).where('status','==','active')).
    match /datingMatches/{pairId} {
      allow read: if signedIn() && request.auth.uid in resource.data.uids && resource.data.status == 'active';
      allow write: if false;

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/datingMatches/$(pairId)).data.uids
          && get(/databases/$(database)/documents/datingMatches/$(pairId)).data.status == 'active';
        allow write: if false;
      }
    }

    // usernames/*, tableCodes/*, idempotency/*, rateLimits/*, datingProfiles/*, datingLikes/*,
    // datingBlocks/*, config/* and anything else: denied (no match block grants access).
  }
}
