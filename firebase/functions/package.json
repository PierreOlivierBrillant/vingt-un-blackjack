{
  "name": "blackjack-functions",
  "private": true,
  "description": "Server-authoritative backend for the fake-money blackjack app (Firebase emulators only, project demo-blackjack).",
  "main": "lib/index.js",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test:unit": "vitest run --config vitest.unit.config.mts",
    "test:rules": "vitest run --config vitest.rules.config.mts",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "golden:update": "vitest run --config vitest.unit.config.mts test/unit/golden.test.ts -u"
  },
  "dependencies": {
    "firebase-admin": "14.5.1",
    "firebase-functions": "7.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@firebase/rules-unit-testing": "6.0.0",
    "@types/node": "^24.0.0",
    "eslint": "10.15.0",
    "fast-check": "4.10.3",
    "firebase": "13.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
