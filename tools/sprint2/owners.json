        "firebase/functions/src/shared/games/holdem.ts",
        "firebase/functions/test/unit/holdem/**",
        "firebase/functions/test/unit/holdem*.test.ts",
        "firebase/functions/test/golden/holdem*",
        "firebase/functions/test/integration/holdem*.test.ts",
        "app/lib/features/games/holdem/**",
        "app/l10n/parts/holdem.*.arb",
        "tools/sfx/games/holdem.mjs",
