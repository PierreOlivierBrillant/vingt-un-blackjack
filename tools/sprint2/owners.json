        "firebase/functions/test/unit/dating*.test.ts",
        "firebase/functions/test/integration/romance*.test.ts",
        "firebase/functions/test/integration/dating*.test.ts",
        "app/lib/features/romance/**",
        "app/assets/story/**",
        "app/l10n/parts/romance.*.arb",
        "tools/sfx/games/romance.mjs",
        "app/test/**/romance/**",
        "app/test/**/romance*",
        "app/test/**/dating*"
      ]
    }
  }
}
