    "craps": {
      "description": "Craps : moteur, module, bots, marchés, équité, écran, animations, sons, textes, tests.",
      "allow": [
        "tools/sprint2/requests/craps.md",
        "firebase/functions/src/games/craps/**",
        "firebase/functions/src/shared/games/craps.ts",
        "firebase/functions/test/unit/craps/**",
        "firebase/functions/test/unit/craps*.test.ts",
        "firebase/functions/test/golden/craps*",
        "firebase/functions/test/integration/craps*.test.ts",
        "app/lib/features/games/craps/**",
        "app/l10n/parts/craps.*.arb",
        "tools/sfx/games/craps.mjs",
        "app/test/**/craps/**",
        "app/test/**/craps*",
        "app/assets/fairness/craps*"
      ]
    },
    "romance": {
      "description": "Rendez-vous : histoire JSON, callables romance/dating, bots de rencontre, hub, visual novel, cadeaux, Souvenirs, rencontres, tests.",
      "allow": [
        "tools/sprint2/requests/romance.md",
        "tools/sync_story.mjs",
        "firebase/functions/src/romance/**",
        "firebase/functions/src/shared/romance.ts",
        "firebase/functions/src/callables/romance.ts",
        "firebase/functions/src/callables/dating.ts",
        "firebase/functions/test/unit/romance/**",
